rules_version = '2';
// ぶっ飛ばせ！ムカつくアイツ！ ランキング用ルール（Spark 無料プランで動く構成）
// Cloud Functions を使わず、Rules 側で以下を検証する：
//  - 匿名認証済みの本人のドキュメントにだけ書ける
//  - 送信された5回の精度からパワー（判定・コンボ・精度ボーナス）を再計算し、一致しないものは拒否
//  - 日次ランキングの日付は日本時間（サーバー時刻）で決まり、改ざん不可
//  - 自己ベストを更新するときだけ書ける
//  - 10秒に1回までのレート制限（users/{uid}.lastSubmitAt を同じバッチで更新させる）
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // 精度(acc)は 0〜1000 の整数。判定：PERFECT ≥970 / GREAT ≥800 / GOOD ≥500 / MISS
    function isAcc(a) { return a is int && a >= 0 && a <= 1000; }
    function pts(a) { return a >= 970 ? 300 : (a >= 800 ? 200 : (a >= 500 ? 130 : 50)); }
    function prec(a) { return a > 900 ? a - 900 : 0; }
    function p(ac, i) { return ac[i] >= 970 ? 1 : 0; }
    // i 番目のラウンド時点の PERFECT 連続数
    function s0(ac) { return p(ac, 0); }
    function s1(ac) { return p(ac, 1) * (s0(ac) + 1); }
    function s2(ac) { return p(ac, 2) * (s1(ac) + 1); }
    function s3(ac) { return p(ac, 3) * (s2(ac) + 1); }
    function s4(ac) { return p(ac, 4) * (s3(ac) + 1); }
    function bonus(s) { return s == 2 ? 100 : (s == 3 ? 200 : (s == 4 ? 300 : (s == 5 ? 500 : 0))); }
    function powerOf(ac) {
      return 100 + pts(ac[0]) + pts(ac[1]) + pts(ac[2]) + pts(ac[3]) + pts(ac[4])
        + bonus(s0(ac)) + bonus(s1(ac)) + bonus(s2(ac)) + bonus(s3(ac)) + bonus(s4(ac))
        + prec(ac[0]) + prec(ac[1]) + prec(ac[2]) + prec(ac[3]) + prec(ac[4]);
    }
    function jstDay() {
      let t = request.time + duration.value(9, 'h');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }
    function validNick(n) { return n is string && n.size() >= 1 && n.size() <= 12 && !n.matches('.*[<>].*'); }
    function validEntry(d) {
      return d.keys().hasOnly(['uid', 'day', 'nickname', 'power', 'accs', 'characterId', 'achievedAt'])
        && d.keys().hasAll(['uid', 'day', 'nickname', 'power', 'accs', 'characterId', 'achievedAt'])
        && d.uid == request.auth.uid
        && d.day == jstDay()
        && validNick(d.nickname)
        && d.accs is list && d.accs.size() == 5
        && isAcc(d.accs[0]) && isAcc(d.accs[1]) && isAcc(d.accs[2]) && isAcc(d.accs[3]) && isAcc(d.accs[4])
        && d.power is int && d.power == powerOf(d.accs)
        && d.characterId is string && d.characterId.matches('^(preset-0[1-4]|custom)$')
        && d.achievedAt == request.time;
    }
    function bumpedRateLimit() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastSubmitAt == request.time;
    }
    function improves() { return resource == null || request.resource.data.power > resource.data.power; }
    function nickOnly() {
      return resource != null && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
        && validNick(request.resource.data.nickname);
    }
    function scoreWrite() { return validEntry(request.resource.data) && improves() && bumpedRateLimit(); }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname'])
        && validNick(request.resource.data.nickname);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'lastSubmitAt'])
        && validNick(request.resource.data.nickname)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSubmitAt'])
            && request.resource.data.lastSubmitAt == request.time
            && (!('lastSubmitAt' in resource.data) || request.time > resource.data.lastSubmitAt + duration.value(10, 's'))
          )
        );
      allow delete: if false;
    }

    // 日次ランキング：daily/{日本時間の日付}/scores/{uid}（インデックス作成不要の構成）
    match /daily/{day}/scores/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid && day == string(jstDay()) && (scoreWrite() || nickOnly());
      allow delete: if false;
    }

    match /alltime/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid && (scoreWrite() || nickOnly());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
